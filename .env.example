# Configure these as hosted Sites runtime values; never commit real values. See docs/push-notifications.md.
# Firebase web app config as one-line JSON: {"apiKey":"...","authDomain":"...","projectId":"...","messagingSenderId":"...","appId":"..."}
FIREBASE_WEB_CONFIG=
# Cloud Messaging > Web Push certificates > key pair (public key).
FIREBASE_VAPID_KEY=
# Service account JSON (one line) with Firebase Cloud Messaging access. Secret.
FIREBASE_SERVICE_ACCOUNT=
